{
  "schema": "ars-noctis.distribution/v1",
  "id": "ars-noctis",
  "default_profile": "core",
  "profiles": {
    "core": [
      "ars",
      "noctis"
    ],
    "full": [
      "ars",
      "noctis",
      "implement",
      "code-review",
      "verify"
    ]
  },
  "skills": [
    {
      "id": "ars",
      "source": "skills/ars",
      "requires": {
        "python": ">=3.11",
        "executables": [
          "git"
        ]
      },
      "checks": [
        {
          "id": "manifest",
          "run": "python",
          "path": "scripts/ars.py",
          "args": [
            "validate",
            "--skill",
            "."
          ]
        }
      ]
    },
    {
      "id": "noctis",
      "source": "skills/noctis",
      "requires": {
        "python": ">=3.11",
        "python_modules": [
          "sqlite3"
        ],
        "executables": [
          "git"
        ]
      },
      "checks": [
        {
          "id": "example-plan",
          "run": "python",
          "path": "scripts/noctis.py",
          "args": [
            "plan-check",
            "--plan",
            "assets/plan.example.json"
          ]
        }
      ]
    },
    {
      "id": "implement",
      "source": "skills/implement"
    },
    {
      "id": "code-review",
      "source": "skills/code-review"
    },
    {
      "id": "verify",
      "source": "skills/verify"
    }
  ]
}

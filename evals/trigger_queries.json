{
  "version": 1,
  "cases": [
    {"id": "ars-create", "skill": "ars", "prompt": "创建一个能被其他 Agent 工作流发现的数据清洗 Skill，并给它定义稳定能力接口。", "should_trigger": true},
    {"id": "ars-adopt", "skill": "ars", "prompt": "把这个自有 Skill 迁移到新的 Ars manifest；第三方目录不要原地修改。", "should_trigger": true},
    {"id": "ars-validate", "skill": "ars", "prompt": "检查 skills/report-export 的 ars.json 是否符合公开契约。", "should_trigger": true},
    {"id": "ars-noctis-adapt", "skill": "ars", "prompt": "把这份 Ars Plan 转成协议无关的 Noctis Plan，并冻结本次 provider 快照。", "should_trigger": true},
    {"id": "ars-app-runtime", "skill": "ars", "prompt": "$ars 为当前仓库初始化 Codex App profile，让实现使用主 Agent、审查使用独立 Agent 和指定模型。", "should_trigger": true},
    {"id": "ars-use", "skill": "ars", "prompt": "运行现有 PDF Skill 合并这两个文件。", "should_trigger": false},
    {"id": "ars-code", "skill": "ars", "prompt": "修复报表导出脚本的空指针。", "should_trigger": false},
    {"id": "ars-orchestrate", "skill": "ars", "prompt": "把实现、审查和验收组成一个断线后可恢复的任务图。", "should_trigger": false},
    {"id": "ars-noctis-only", "skill": "ars", "prompt": "$noctis 只保存这组通用 executor 的 DAG，不发现 provider，也不配置模型。", "should_trigger": false},

    {"id": "noctis-explicit", "skill": "noctis", "prompt": "$noctis 为实现、独立审查和行为验收创建一个可恢复 Run。", "should_trigger": true},
    {"id": "noctis-durable", "skill": "noctis", "prompt": "这个工作要跨三个 Skills，依赖结果需要持久化，换会话后还能继续。", "should_trigger": true},
    {"id": "noctis-resume", "skill": "noctis", "prompt": "查看当前项目未完成的 Noctis Run，从 working Task 的现有证据恢复。", "should_trigger": true},
    {"id": "noctis-clone-resume", "skill": "noctis", "prompt": "我在新机器 clone 了这个仓库；实现任务已经提交，继续尚未完成的独立审查任务。", "should_trigger": true},
    {"id": "noctis-dynamic-add", "skill": "noctis", "prompt": "当前 Run 做到一半，我临时想增加一个依赖实现结果的验收 Task，保留已有任务历史。", "should_trigger": true},
    {"id": "noctis-generic-executor", "skill": "noctis", "prompt": "用 Noctis 持久化这组自定义 executor 的任务图；executor 的 request 和 output 不需要 Core 理解。", "should_trigger": true},
    {"id": "noctis-small", "skill": "noctis", "prompt": "只修改这一行配置并跑相关测试。", "should_trigger": false},
    {"id": "noctis-review", "skill": "noctis", "prompt": "只审查这个 commit，不要修改文件。", "should_trigger": false},
    {"id": "noctis-simple-multistep", "skill": "noctis", "prompt": "修复这个函数并运行它已有的单元测试。", "should_trigger": false},
    {"id": "noctis-clone-explain", "skill": "noctis", "prompt": "刚 clone 了仓库，解释一下配置加载模块，不要创建或恢复工作流。", "should_trigger": false},
    {"id": "noctis-skill-discovery", "skill": "noctis", "prompt": "只检查这个 Skill 的 ars.json 能力声明，不要创建工作流。", "should_trigger": false},

    {"id": "spec-discuss", "skill": "spec", "prompt": "我想增加团队级用量限制，但角色、超限表现和管理范围还不清楚。结合现有权限模型逐项和我讨论，最后形成需求文档。", "should_trigger": true},
    {"id": "spec-repo-aware", "skill": "spec", "prompt": "根据仓库里的导出流程和这些用户反馈，澄清真正要解决的问题、范围与验收条件。能从代码查到的就别问我。", "should_trigger": true},
    {"id": "spec-synthesize", "skill": "spec", "prompt": "我们已经把目标用户、业务规则和非目标谈清楚了，把当前上下文整理成带编号需求和验收条件的规格文档。", "should_trigger": true},
    {"id": "spec-scope", "skill": "spec", "prompt": "帮我明确这项批量退款需求包含什么、不包含什么，以及用户能够观察到的成功结果。", "should_trigger": true},
    {"id": "spec-design", "skill": "spec", "prompt": "需求已经批准，请设计组件边界、接口、迁移方案和实现任务依赖。", "should_trigger": false},
    {"id": "spec-implement", "skill": "spec", "prompt": "直接实现订单筛选并运行回归测试。", "should_trigger": false},
    {"id": "spec-review", "skill": "spec", "prompt": "只读审查当前 diff，找出能触发真实错误的问题。", "should_trigger": false},
    {"id": "spec-verify", "skill": "spec", "prompt": "在测试环境按既定场景验收退款流程并记录证据。", "should_trigger": false},

    {"id": "design-from-spec", "skill": "design", "prompt": "根据 docs/specs/team-limits.md 设计技术方案，列出组件、接口、任务依赖和验证方式。", "should_trigger": true},
    {"id": "design-direct", "skill": "design", "prompt": "需求已经明确，不用先写 PRD；直接设计缓存失效的数据流、错误路径和可独立验收的实现任务。", "should_trigger": true},
    {"id": "design-migration", "skill": "design", "prompt": "为这个已确定的账号表升级需求形成兼容迁移、回滚和分阶段实施设计。", "should_trigger": true},
    {"id": "design-task-dag", "skill": "design", "prompt": "把这份明确需求拆成有依赖关系的任务，每项写清涉及模块、输入输出接口、验收条件和测试方法。", "should_trigger": true},
    {"id": "design-spec", "skill": "design", "prompt": "我只有一个模糊想法，请一次问我一个问题，先明确用户、范围和验收条件并形成需求文档。", "should_trigger": false},
    {"id": "design-implement", "skill": "design", "prompt": "修改数据库适配器并把所有测试跑通。", "should_trigger": false},
    {"id": "design-review", "skill": "design", "prompt": "审查提交 4d1e... 的兼容性风险，不要修改文件。", "should_trigger": false},
    {"id": "design-verify", "skill": "design", "prompt": "在浏览器里执行已经写好的登录验收场景并截图。", "should_trigger": false},

    {"id": "test-unit-risk", "skill": "test", "prompt": "为税费计算器补单元测试，先找真正有回归风险的规则和边界，不要为了覆盖率凑用例。", "should_trigger": true},
    {"id": "test-gap-analysis", "skill": "test", "prompt": "分析权限规则现有测试缺口，选择最低充分测试等级并只补有价值的测试。", "should_trigger": true},
    {"id": "test-integration", "skill": "test", "prompt": "重复支付回调可能违反数据库唯一约束，请判断单测是否足够；不足就设计并实现最小集成测试。", "should_trigger": true},
    {"id": "test-manual", "skill": "test", "prompt": "这个画布缩放问题很难稳定自动化，请规划一次有明确观察项和边界说明的非自动化测试。", "should_trigger": true},
    {"id": "test-implementation-incidental", "skill": "test", "prompt": "实现订单筛选功能，并运行与改动相称的现有单元测试。", "should_trigger": false},
    {"id": "test-verify", "skill": "test", "prompt": "按已经批准的退款场景在测试环境执行验收，并给出通过或失败判定。", "should_trigger": false},
    {"id": "test-review", "skill": "test", "prompt": "只读审查当前 diff，指出正确性问题和测试缺口，不要修改文件。", "should_trigger": false},
    {"id": "test-design", "skill": "test", "prompt": "为明确的账号升级需求设计组件接口、迁移方案和任务 DAG。", "should_trigger": false},

    {"id": "implement-feature", "skill": "implement", "prompt": "实现订单列表的状态筛选，沿用仓库现有查询参数模式。", "should_trigger": true},
    {"id": "implement-fix", "skill": "implement", "prompt": "修复空配置导致的崩溃并运行相关回归测试。", "should_trigger": true},
    {"id": "implement-review-fixes", "skill": "implement", "prompt": "应用我已接受的两条 review 意见，不要处理其余建议。", "should_trigger": true},
    {"id": "implement-diagnose", "skill": "implement", "prompt": "只诊断为什么构建失败，先不要改代码。", "should_trigger": false},
    {"id": "implement-review", "skill": "implement", "prompt": "审查这个 PR 并按严重级别列问题，不要修改。", "should_trigger": false},
    {"id": "implement-orchestration", "skill": "implement", "prompt": "为实现、审查和验收设计一个可恢复的多 Skill DAG。", "should_trigger": false},

    {"id": "review-diff", "skill": "code-review", "prompt": "审查当前 diff，只报告能触发真实错误的问题。", "should_trigger": true},
    {"id": "review-commit", "skill": "code-review", "prompt": "对提交 4d1e... 做只读代码审查，重点看兼容性回归。", "should_trigger": true},
    {"id": "review-recheck", "skill": "code-review", "prompt": "复核上次 P1 的修复是否完整，不要顺手修改。", "should_trigger": true},
    {"id": "review-fix", "skill": "code-review", "prompt": "把审查发现的三个问题直接修掉并跑测试。", "should_trigger": false},
    {"id": "review-explain", "skill": "code-review", "prompt": "解释这段缓存代码是怎么工作的。", "should_trigger": false},
    {"id": "review-acceptance", "skill": "code-review", "prompt": "在浏览器里验收登录流程并截图。", "should_trigger": false},

    {"id": "verify-browser", "skill": "verify", "prompt": "按验收场景在测试环境走一遍退款流程，并记录每一步的实际结果。", "should_trigger": true},
    {"id": "verify-integration", "skill": "verify", "prompt": "验证服务重启后任务仍能恢复，给出日志证据和明确判定。", "should_trigger": true},
    {"id": "verify-assisted", "skill": "verify", "prompt": "打开页面并准备测试数据，我来做最终的人工作验收判定。", "should_trigger": true},
    {"id": "verify-unit-authoring", "skill": "verify", "prompt": "给这个函数补三个单元测试。", "should_trigger": false},
    {"id": "verify-static", "skill": "verify", "prompt": "静态审查这段权限代码是否存在漏洞。", "should_trigger": false},
    {"id": "verify-implement", "skill": "verify", "prompt": "实现登录页面的记住我功能。", "should_trigger": false}
  ]
}
